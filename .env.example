APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.com
APP_KEY=change-this-to-a-random-64-character-secret

DB_HOST=127.0.0.1
DB_PORT=3306
DB_WEB_DATABASE=oufeidun_web
DB_APP_DATABASE=oufeidun_app
# Có thể dùng một tài khoản chung bằng DB_USERNAME/DB_PASSWORD,
# hoặc cấp riêng quyền tối thiểu cho từng schema bằng bốn biến dưới đây.
DB_USERNAME=oufeidun_user
DB_PASSWORD=
DB_WEB_USERNAME=
DB_WEB_PASSWORD=
DB_APP_USERNAME=
DB_APP_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
# Shared hosting thường tạo sẵn database trong control panel. Chỉ bật true khi MySQL user có quyền CREATE DATABASE.
DB_CREATE_DATABASES=false

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Oufeidun
CONTACT_TO_EMAIL=

GLASS_LOOKUP_ENABLED=true
TRUSTED_PROXY_IP_HEADER=
APP_API_ALLOWED_ORIGINS=shop://app,http://127.0.0.1:5178
